{
  "name": "labby",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "warn"
    }
  },
  "description": "Academic seminar scheduling system",
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @labby/core build",
    "build:server": "pnpm --filter @labby/server build",
    "build:server:web": "pnpm --filter @labby/web build:server",
    "build:web": "pnpm --filter @labby/web build:frontend",
    "dev": "pnpm --filter @labby/web dev:frontend",
    "dev:server": "pnpm --filter @labby/server dev",
    "dev:server:web": "pnpm --filter @labby/web dev:server",
    "preview": "pnpm --filter @labby/web preview",
    "db:init": "pnpm --filter @labby/server run db:init",
    "db:migrate": "pnpm --filter @labby/server run db:migrate",
    "deploy:cloudrun:incremental": "pnpm --filter @labby/server exec tsx ../../scripts/cloud-run-incremental-deploy.ts",
    "deploy:railway": "pnpm --filter @labby/server exec tsx ../../scripts/railway-deploy.ts --full --target server",
    "deploy:railway:incremental": "pnpm --filter @labby/server exec tsx ../../scripts/railway-deploy.ts --incremental --target server",
    "deploy:railway:cron": "pnpm --filter @labby/server exec tsx ../../scripts/railway-deploy.ts --full --target cron",
    "deploy:railway:cron:incremental": "pnpm --filter @labby/server exec tsx ../../scripts/railway-deploy.ts --incremental --target cron",
    "railway:plan": "node scripts/railway-config.mjs plan",
    "railway:apply": "node scripts/railway-config.mjs apply",
    "railway:cron": "node packages/server/dist/cron/railway-dispatch.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "env-lane": "^0.4.2",
    "typescript": "^7.0.2"
  }
}
