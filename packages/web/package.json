{
  "name": "@labby/web",
  "version": "0.1.0",
  "description": "Labby web UI – Preact + Vite + vanilla-extract",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "VITE_DB_CONFIG=pglite VITE_DEPLOYMENT_MODE=frontend-only vite",
    "dev:server": "VITE_DB_CONFIG=api VITE_DEPLOYMENT_MODE=server vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:frontend": "tsc -p tsconfig.json --noEmit && VITE_DB_CONFIG=pglite VITE_DEPLOYMENT_MODE=frontend-only vite build",
    "build:server": "tsc -p tsconfig.json --noEmit && VITE_DB_CONFIG=api VITE_DEPLOYMENT_MODE=server vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts && pnpm test:render",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:gen": "tsx scripts/i18n-gen.ts",
    "test:render": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@electric-sql/pglite": "^0.5.8",
    "@labby/core": "workspace:*",
    "@luma.gl/webgpu": "^9.4.1",
    "@msgpack/msgpack": "^3.1.3",
    "@preact/signals": "^2.11.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-preact": "^1.46.0",
    "nanoid": "^6.0.1",
    "papaparse": "^5.7.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
