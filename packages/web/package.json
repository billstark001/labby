{
  "name": "@labby/web",
  "version": "0.1.0",
  "description": "Labby web UI – Preact + Vite + vanilla-extract",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "VITE_DB_CONFIG=pglite VITE_DEPLOYMENT_MODE=frontend-only vite",
    "dev:server": "VITE_DB_CONFIG=api VITE_DEPLOYMENT_MODE=server vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:frontend": "VITE_DB_CONFIG=pglite VITE_DEPLOYMENT_MODE=frontend-only tsc -p tsconfig.json --noEmit && vite build",
    "build:server": "VITE_DB_CONFIG=api VITE_DEPLOYMENT_MODE=server tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:gen": "tsx scripts/i18n-gen.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@electric-sql/pglite": "^0.5.4",
    "@labby/core": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "@preact/signals": "^2.9.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-preact": "^1.23.0",
    "nanoid": "^5.1.16",
    "papaparse": "^5.5.4",
    "preact": "^10.29.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.0",
    "@types/papaparse": "^5.5.2",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/vite-plugin": "^5.2.3",
    "js-yaml": "^5.2.1",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
