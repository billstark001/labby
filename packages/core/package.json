{
  "name": "@labby/core",
  "version": "0.1.0",
  "description": "Core algorithms, data structures and type definitions for Labby",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "benchmark:dimensions": "tsx scripts/dimension-benchmark.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "pure-expr": "^0.2.0"
  }
}
