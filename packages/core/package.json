{
  "name": "@labby/core",
  "version": "0.1.0",
  "description": "Core algorithms, data structures and type definitions for Labby",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "triplet:cli": "pnpm exec tsx scripts/triplet-supervision-cli.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "marked": "^18.0.5",
    "pure-expr": "^0.2.0"
  }
}
