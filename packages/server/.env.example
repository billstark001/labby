# Labby server environment configuration
# Copy this file to .env and fill in the values.

# Server
NODE_ENV=development
PORT=4410
WEB_DIST_DIR=../web/dist

# Database
# Use pglite for local development or postgres with DATABASE_URL for a remote database.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./run/labby-pg
DATABASE_URL=
DATABASE_SSL=false

# PASETO token signing secret (generate with: openssl rand -base64 32)
PASETO_SECRET=your-secret-here
# Or use separate keys:
# PASETO_ACCESS_KEY=k4.local.your-access-key-here
# PASETO_REFRESH_KEY=k4.local.your-refresh-key-here

# Token TTLs
AUTH_ISSUER=labby-server
AUTH_AUDIENCE=labby-web
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_CODE_TTL=15m

# Root user (credentials from environment only, NEVER stored in the database)
ROOT_USERNAME=root
ROOT_PASSWORD=change-me-immediately
ROOT_EMAIL=root@example.com

# SMTP (optional – leave SMTP_HOST blank to disable email notifications)
SMTP_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Labby <noreply@example.com>

# Gmail OAuth (set SMTP_PROVIDER=gmail-api for HTTPS delivery, or gmail for SMTP)
GMAIL_USER=
GMAIL_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# File fallback for local development or mounted provider secrets
GOOGLE_OAUTH_JSON_PATH=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REFRESH_TOKEN_PATH=

# Public ICS endpoint for email tasks (optional)
PUBLIC_BASE_URL=http://localhost:4410

# Fixed jobs (authentication cleanup and backup): cron | cloud | external
# Dynamic jobs (email tasks and schedule notifications): cron | cloud
# external means a separately configured provider such as Railway Cron calls the dispatch endpoint.
# Set both explicitly in production; omission defaults to cron only for nonproduction runs.
STATIC_SCHEDULER_MODE=cron
DYNAMIC_SCHEDULER_MODE=cron

# Internal dispatch auth used by Cloud Scheduler or Railway Cron callbacks
SCHEDULER_DISPATCH_API_KEY=

# Cloud Scheduler sync settings (required when either job group uses cloud)
CLOUD_SCHEDULER_PROJECT_ID=
CLOUD_SCHEDULER_LOCATION=
# Optional explicit dispatch URL; defaults to ${PUBLIC_BASE_URL}/internal/scheduler/dispatch
CLOUD_SCHEDULER_DISPATCH_URL=
CLOUD_SCHEDULER_JOB_PREFIX=labby
# Optional explicit service account fields; otherwise Google ADC is used.
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
# Local credential file. Railway deployment expands it to the fields above;
# the path itself is not sent to Railway. File must be a regular 0600 file.
GOOGLE_APPLICATION_CREDENTIALS=

# Expired authentication record cleanup
AUTH_CLEANUP_CRON=17 3 * * *
AUTH_CLEANUP_TIMEZONE=UTC

# Comma-separated list of email addresses to notify
NOTIFY_RECIPIENTS=

# Backup subsystem (leave BACKUP_CRON blank to disable)
BACKUP_CRON=
BACKUP_TIMEZONE=UTC
BACKUP_FORMAT=msgpack
BACKUP_TARGET=email
BACKUP_FILENAME_PREFIX=labby
BACKUP_EMAIL_RECIPIENTS=

# Google Drive backup target
GOOGLE_DRIVE_FOLDER_ID=

# OneDrive backup target
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_FOLDER=/Apps/Labby
