PUBLIC_BASE_URL=https://example.run.app
PASETO_SECRET=
ROOT_USERNAME=root
ROOT_PASSWORD=
ROOT_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
