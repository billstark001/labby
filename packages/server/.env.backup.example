# Example backup-oriented server configuration for Labby.
# Copy the parts you need into .env.

# Core server settings
PORT=4410
PGLITE_DATA_DIR=./run/labby-pg
PASETO_SECRET=replace-me
ROOT_USERNAME=root
ROOT_PASSWORD=replace-me
ROOT_EMAIL=root@example.com

# Option A: Gmail via Google OAuth
SMTP_PROVIDER=gmail
SMTP_FROM=Labby <your-account@gmail.com>
GMAIL_USER=your-account@gmail.com
GMAIL_REFRESH_TOKEN=google-refresh-token-for-gmail
GOOGLE_OAUTH_JSON_PATH=./secrets/google-oauth-client.json

# Default notification recipients
NOTIFY_RECIPIENTS=ops@example.com

# Scheduled backup defaults
BACKUP_CRON=0 3 * * *
BACKUP_TIMEZONE=Asia/Shanghai
BACKUP_FORMAT=msgpack
BACKUP_FILENAME_PREFIX=labby
BACKUP_EMAIL_RECIPIENTS=ops@example.com

# Option B: Email attachment target
BACKUP_TARGET=email

# Option C: Google Drive target
# BACKUP_TARGET=google-drive
# BACKUP_FORMAT=msgpack
# GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
# GOOGLE_OAUTH_REFRESH_TOKEN=google-refresh-token-with-drive-scope

# Option D: OneDrive target
# BACKUP_TARGET=onedrive
# ONEDRIVE_CLIENT_ID=your-microsoft-app-id
# ONEDRIVE_CLIENT_SECRET=your-microsoft-app-secret
# ONEDRIVE_REFRESH_TOKEN=your-microsoft-refresh-token
# ONEDRIVE_TENANT_ID=common
# ONEDRIVE_FOLDER=/Apps/Labby
