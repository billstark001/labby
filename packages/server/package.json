{
  "name": "@labby/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend server for Labby, handling API requests, authentication, and database interactions",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "auth:gmail": "tsx scripts/gmail-auth.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@hono/node-server": "^2.0.8",
    "@labby/core": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "@mpoonuru/paseto": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "hono": "^4.12.27",
    "node-cron": "4.5.0",
    "nodemailer": "9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
