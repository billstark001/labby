{
  "name": "@labby/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend server for Labby, handling API requests, authentication, and database interactions",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migration-sql.mjs",
    "start": "node dist/index.js",
    "auth:gmail": "tsx scripts/gmail-auth.ts",
    "db:init": "tsx scripts/db-init.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "db:similarity-locks": "tsx scripts/db-similarity-locks.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@hono/node-server": "^2.1.1",
    "@labby/core": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "@mpoonuru/paseto": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.7",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.10",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
