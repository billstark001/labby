NODE_ENV=production
DB_DRIVER=postgres
DATABASE_URL=
DATABASE_SSL=true
WEB_DIST_DIR=/app/packages/web/dist
PUBLIC_BASE_URL=https://example.up.railway.app
PASETO_SECRET=
ROOT_USERNAME=root
ROOT_PASSWORD=
ROOT_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional Gmail API delivery over HTTPS on Railway Hobby:
# SMTP_PROVIDER=gmail-api
# GMAIL_USER=sender@example.com
# SMTP_FROM=sender@example.com
# Set GMAIL_REFRESH_TOKEN separately only if the shared token lacks Gmail scope.
# GMAIL_REFRESH_TOKEN=
SCHEDULER_MODE=external
SCHEDULER_DISPATCH_API_KEY=
