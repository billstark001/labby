NODE_ENV=production
DB_DRIVER=postgres
DATABASE_URL=
DATABASE_SSL=true
WEB_DIST_DIR=/app/packages/web/dist
PUBLIC_BASE_URL=https://example.up.railway.app
PASETO_SECRET=
ROOT_USERNAME=root
ROOT_PASSWORD=
ROOT_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional Gmail API delivery over HTTPS on Railway Hobby:
# SMTP_PROVIDER=gmail-api
# GMAIL_USER=sender@example.com
# SMTP_FROM=sender@example.com
# Set GMAIL_REFRESH_TOKEN separately only if the shared token lacks Gmail scope.
# GMAIL_REFRESH_TOKEN=
STATIC_SCHEDULER_MODE=external
DYNAMIC_SCHEDULER_MODE=cloud
SCHEDULER_DISPATCH_API_KEY=
CLOUD_SCHEDULER_PROJECT_ID=
CLOUD_SCHEDULER_LOCATION=asia-northeast1
# Choose both direct fields, or a private JSON file path relative to this env file.
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
